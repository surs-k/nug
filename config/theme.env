# Ai - theme, the design tokens
#      every colour, font and size the desktop uses comes from here
#      change one line, run `rebuild desktop`, and the bar, the launcher, the
#      lock screen, notifications, the terminal and window borders all follow
#      red, amber and green mean the same here as in Changes and the install

# Ai - surfaces, darkest to lightest
BG="#14161b"
SURFACE="#1c1f26"
OVERLAY="#2a2f3a"

# Ai - text
TEXT="#e3e5ea"
MUTED="#8a909c"

# Ai - one accent, used sparingly: focus, selection, the active workspace
ACCENT="#7aa2f7"

# Ai - meaning
BAD="#d0453b"
WARN="#c8891a"
GOOD="#2e9e5b"

# Ai - type
FONT="JetBrainsMono Nerd Font"
FONT_UI="Noto Sans"
FONT_SIZE="11"

# Ai - shape, in pixels
RADIUS="8"
GAP="5"
BORDER="2"
